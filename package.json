{
  "name": "directory",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "lighthouse:home": "node ../tooling/lighthouse/lighthouse.mjs",
    "lighthouse:business": "node ../tooling/lighthouse/lighthouse.mjs http://localhost:3000/business/test-id",
    "test:scaffold": "npm --prefix directory run test",
    "lint:scaffold": "npm --prefix directory run lint",
    "typecheck": "tsc --noEmit",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:runtime-package": "node --test scripts/prepare-runtime.check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "axe-playwright": "^1.2.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.41.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  }
}
